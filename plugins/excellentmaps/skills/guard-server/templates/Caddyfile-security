# ═══════════════════════════════════════════════════════════════════════
# Боевой Caddyfile для сайта с автоматическим HTTPS
# Guard Security Suite © ExcellentMaps — github.com/ExcellentMaps
#
# КУДА КЛАСТЬ: /etc/caddy/Caddyfile
#
# ⚠️ ЧТО ЗАМЕНИТЬ ПЕРЕД ПРИМЕНЕНИЕМ:
#   1. ВАШ_ДОМЕН         — строка с именем сайта
#   2. почта@пример.ru   — адрес для уведомлений удостоверяющего центра
#   3. /var/www/site     — каталог собранного фронтенда
#   4. /var/www/files    — каталог пользовательских файлов (или убрать блок)
#   5. 127.0.0.1:8000    — адрес вашего бэкенда
#   6. /api/auth/login   — реальный путь страницы входа
#   7. CSP ниже          — домены ваших виджетов, карт, счётчиков
#
# ⚠️ CSP ВКЛЮЧАТЬ НЕ СРАЗУ. Сначала переименуйте заголовок в
#   Content-Security-Policy-Report-Only, обойдите все разделы сайта
#   с открытой консолью браузера, почините нарушения — и только потом
#   верните боевое имя. Подробно: references/headers-and-csp.md
#
# ⚠️ RATE_LIMIT ТРЕБУЕТ СТОРОННЕГО МОДУЛЯ. В штатной поставке Caddy
#   ограничения частоты нет. Нужен caddy-ratelimit, который встраивается
#   ПЕРЕСБОРКОЙ исполняемого файла через xcaddy:
#       xcaddy build --with github.com/mholt/caddy-ratelimit
#   Пока модуль не собран, блок rate_limit ниже ЗАКОММЕНТИРОВАН —
#   с ним необорудованный Caddy просто не запустится.
#   Альтернатива: держать ограничение частоты в самом приложении.
#
# КАК ПРОВЕРИТЬ:
#   sudo caddy validate --config /etc/caddy/Caddyfile   # синтаксис
#   sudo systemctl reload caddy                         # применить
#   bash audit-live.sh ВАШ_ДОМЕН                        # проверка снаружи
#
# КАК ОТКАТИТЬ:
#   sudo cp /etc/caddy/Caddyfile.bak /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && \
#       sudo systemctl reload caddy
#   (копию .bak сделайте ДО правки)
# ═══════════════════════════════════════════════════════════════════════


# ── ГЛОБАЛЬНЫЕ НАСТРОЙКИ ──────────────────────────────────────────────
{
    # Почта для удостоверяющего центра: сюда придёт предупреждение,
    # если продление сертификата перестанет проходить.
    email почта@пример.ru
}


ВАШ_ДОМЕН {
    # ── TLS ───────────────────────────────────────────────────────────
    # Отдельной настройки не требуется: Caddy сам выпускает сертификат
    # при первом запуске, сам продлевает его фоном и сам перенаправляет
    # http на https. Ни certbot, ни таймеров, ни хуков перезагрузки.
    # Именно поэтому здесь нет ни одной строки про сертификаты.

    root * /var/www/site
    encode gzip zstd

    # ── ЗАГОЛОВКИ БЕЗОПАСНОСТИ ────────────────────────────────────────
    header {
        # Браузер запоминает: на этот сайт — только по защищённому
        # соединению. ⚠️ Начинайте с max-age=300 и наращивайте только
        # после первого успешного автопродления: откатить большой
        # max-age быстро невозможно — запрет живёт в браузере
        # пользователя, а не у вас на сервере.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"

        # Браузер не угадывает тип файла по содержимому. Загруженная
        # «картинка» с кодом внутри не выполнится как скрипт.
        X-Content-Type-Options "nosniff"

        # Чужие сайты не узнают адрес страницы, с которой к ним пришли —
        # в адресах бывают номера заказов и идентификаторы клиентов.
        Referrer-Policy "strict-origin-when-cross-origin"

        # Страница не может запросить камеру, микрофон и геолокацию.
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Сайт нельзя встроить в чужую страницу. Дублируется в CSP
        # как frame-ancestors — старый заголовок оставлен ради
        # совместимости со старыми браузерами.
        X-Frame-Options "DENY"

        # ⚠️ ЗАМЕНИТЕ https://ВАШ_ВИДЖЕТ.ru на реальные домены чата,
        # карт, счётчика — или уберите их, если ничего стороннего нет.
        # ⚠️ Для первого включения переименуйте заголовок в
        # Content-Security-Policy-Report-Only.
        #   script-src 'self'       код только свой — главная строка
        #                           политики; 'unsafe-inline' сюда
        #                           добавлять нельзя
        #   style-src unsafe-inline уступка сборщикам: это оформление,
        #                           а не код — приемлемо
        #   frame-ancestors 'none'  вашу страницу не встроить никуда
        #   base-uri 'self'         нельзя увести загрузку скриптов
        #   form-action 'self'      формы уходят только на ваш сервер
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ВАШ_ВИДЖЕТ.ru; font-src 'self' data:; connect-src 'self' https://ВАШ_ВИДЖЕТ.ru; worker-src 'self' blob:; manifest-src 'self'; frame-src https://ВАШ_ВИДЖЕТ.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

        # Убрать подсказки о том, на чём работает сервер.
        -Server
        -X-Powered-By
    }

    # ── ЗАПРЕТ СКРЫТЫХ И СЛУЖЕБНЫХ ФАЙЛОВ ─────────────────────────────
    # Закрывает .env, .git/, .htaccess, .DS_Store одним правилом.
    # Открытый .env — все ключи по прямой ссылке; открытый .git/ —
    # весь исходный код вместе с историей.
    # Это вторая линия: сами файлы должны лежать ВНЕ /var/www/site.
    #
    # Путь /.well-known/ исключён явно: через него проходит проверка
    # владения доменом, без него сертификат перестанет продлеваться.
    # ⚠️ Этот handle стоит ВЫШЕ всех остальных: блоки handle
    # проверяются в порядке написания, первый подошедший выигрывает.
    @hidden {
        path /.*
        not path /.well-known/*
    }
    handle @hidden {
        respond 404
    }

    @sensitive path *.sql *.bak *.log *.ini *.conf *.yml *.yaml *.sh
    handle @sensitive {
        respond 404
    }

    # ── ОГРАНИЧЕНИЕ ЧАСТОТЫ ЗАПРОСОВ ──────────────────────────────────
    # ⚠️ Раскомментировать ТОЛЬКО после сборки Caddy с caddy-ratelimit
    # (см. шапку файла). Без модуля Caddy не стартует.
    #
    # ⚠️ Цифры подобрать по реальной нагрузке, а не наугад: сначала
    # посмотреть логи, потом ставить лимит. references/rate-limits.md
    #
    # rate_limit {
    #     # Общая зона: 100 запросов за 10 секунд с адреса — в среднем
    #     # десять в секунду, с естественным допуском на всплески.
    #     zone guard_common {
    #         match {
    #             path /api/*
    #         }
    #         key    {remote_host}
    #         events 100
    #         window 10s
    #     }
    #
    #     # Страница входа — в разы строже: 10 попыток за минуту.
    #     # ⚠️ Точный путь, а не каталог: строгий лимит, случайно
    #     # накрывший весь /api/, сделает интерфейс неработоспособным.
    #     zone guard_login {
    #         match {
    #             path /api/auth/login
    #         }
    #         key    {remote_host}
    #         events 10
    #         window 1m
    #     }
    # }

    # ── ПОЛЬЗОВАТЕЛЬСКИЕ ФАЙЛЫ ────────────────────────────────────────
    # Content-Disposition: attachment — файл всегда скачивается, а не
    # открывается в браузере. Загруженный кем-то HTML или SVG со
    # скриптом внутри не выполнится на вашем домене.
    handle /files/* {
        header {
            Content-Disposition "attachment"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }
        root * /var/www/files
        uri strip_prefix /files
        file_server
    }

    # ── БЭКЕНД ────────────────────────────────────────────────────────
    # Бэкенд слушает 127.0.0.1 и снаружи недоступен вообще —
    # единственный путь к нему идёт через этот блок.
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # ── СТАТИКА С КЕШЕМ ───────────────────────────────────────────────
    # Файлы сборки с хешем в имени: при изменении меняется имя,
    # поэтому их можно кешировать надолго.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=2592000, immutable"

    # Служебный скрипт офлайн-режима кешировать нельзя: иначе
    # у пользователей останется старая версия приложения.
    @sw path /sw.js
    header @sw Cache-Control "no-cache, must-revalidate"

    # ── SPA-FALLBACK ──────────────────────────────────────────────────
    # Одностраничное приложение: маршрутов на диске нет, любой адрес
    # отдаёт index.html, дальше разбирается сам фронтенд.
    # ⚠️ Стоит последним: правила выше должны отработать раньше.
    handle {
        try_files {path} /index.html
        file_server
    }

    # ── ЛОГИ ──────────────────────────────────────────────────────────
    # ⚠️ В лог попадает полный адрес запроса. Если в адресах передаются
    # телефоны, фамилии или токены — они окажутся в логе открытым
    # текстом. Срок хранения ограничен намеренно: см.
    # references/updates-and-logs.md
    log {
        output file /var/log/caddy/access.log {
            roll_size     50MiB
            roll_keep     14
            roll_keep_for 336h
        }
    }
}
