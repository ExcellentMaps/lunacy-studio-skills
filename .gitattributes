# Guard Security Suite — нормализация переводов строк.
# Скрипты и конфиги обязаны быть с LF: с CRLF bash на Linux
# выдаёт "bad interpreter" и ничего не запускается.
* text=auto eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.conf    text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
Caddyfile-security text eol=lf
